---
import { Image } from 'astro:assets';
import morning from '../assets/ambient/branch-clean.webp';
import flyingBird from '../assets/ambient/bird-flight.webp';
import afternoon from '../assets/ambient/afternoon-framed.webp';
import evening from '../assets/ambient/tea-clean.webp';
import moon from '../assets/ambient/moon.webp';
---

<div class="ambient-scene" data-motion-viewport>
  <div class="scene scene-morning" aria-hidden="true">
    <Image
      class="branch-art"
      src={morning}
      alt=""
      widths={[240, 480, 720, 1200]}
      sizes="(max-width: 540px) 130px, (max-width: 1239px) 160px, (max-width: 1340px) 250px, (max-width: 1840px) calc((100vw - 800px) / 2 - 20px), 520px"
      loading="lazy"
      decoding="async"
    />
    <div class="bird-flight">
      <Image
        class="flying-bird"
        src={flyingBird}
        alt=""
        widths={[120, 240, 480]}
        sizes="(max-width: 1239px) 44px, 140px"
        loading="lazy"
        decoding="async"
      />
    </div>
    <span class="sun-dust dust-one"></span>
    <span class="sun-dust dust-two"></span>
  </div>
  <div class="scene scene-afternoon" aria-hidden="true">
    <Image
      class="plant-art"
      src={afternoon}
      alt=""
      widths={[240, 480, 720, 1200]}
      sizes="(max-width: 540px) 130px, (max-width: 1239px) 160px, (max-width: 1340px) 250px, (max-width: 1840px) calc((100vw - 800px) / 2 - 20px), 520px"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="scene scene-evening" aria-hidden="true">
    <Image
      src={evening}
      alt=""
      widths={[240, 480, 720, 1200]}
      sizes="(max-width: 540px) 130px, (max-width: 1239px) 160px, (max-width: 1340px) 250px, (max-width: 1840px) calc((100vw - 800px) / 2 - 20px), 520px"
      loading="lazy"
      decoding="async"
    />
    <svg
      class="steam-layer"
      viewBox="0 0 1536 1024"
      fill="none"
      aria-hidden="true"
    >
      <defs>
        <filter id="tea-softness">
          <feGaussianBlur stdDeviation="1.1" />
        </filter>
      </defs>
      <g
        filter="url(#tea-softness)"
        stroke="#a48d6c"
        stroke-width="7"
        stroke-linecap="round"
      >
        <path
          class="steam steam-one"
          d="M625 438c-38-58 38-98 2-151-20-30-15-57 1-82"
        />
        <path
          class="steam steam-two"
          d="M655 438c33-54-28-89-2-132 20-32 16-63 0-91"
        />
        <path class="steam steam-three" d="M850 330c-31-48 17-73 0-119" />
      </g>
    </svg>
  </div>
  <div class="scene scene-night" aria-hidden="true">
    <span class="moon-halo"></span>
    <Image
      src={moon}
      alt=""
      widths={[240, 480, 720, 1200]}
      sizes="(max-width: 540px) 130px, (max-width: 1239px) 160px, (max-width: 1340px) 250px, (max-width: 1840px) calc((100vw - 800px) / 2 - 20px), 520px"
      loading="lazy"
      decoding="async"
    />
  </div>
</div>
<style>
  .ambient-scene {
    position: absolute;
    right: -2px;
    top: 150px;
    width: clamp(250px, calc((100vw - 800px) / 2 - 20px), 520px);
    aspect-ratio: 3 / 2;
    z-index: 2;
  }
  .scene {
    position: absolute;
    inset: 0;
    display: none;
    animation: arrive-from-edge 1.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .scene :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .scene-morning {
    display: block;
  }
  .scene-morning :global(.branch-art) {
    object-fit: fill;
    transform-origin: 100% 75%;
    animation: branch-breeze 7s ease-in-out infinite alternate;
  }
  .bird-flight {
    position: absolute;
    width: 29%;
    aspect-ratio: 3 / 2;
    left: 29%;
    top: 28%;
    animation: doyel-flight 18s ease-in-out infinite;
  }
  .bird-flight :global(.flying-bird) {
    animation: wing-beat 0.9s ease-in-out infinite alternate;
    transform-origin: 50% 70%;
  }
  .scene-afternoon {
    left: 35%;
    right: -16%;
  }
  .scene-afternoon :global(.plant-art) {
    transform-origin: 100% 90%;
    animation: foliage-breeze 5s ease-in-out infinite alternate;
  }
  .scene-evening :global(img) {
    object-fit: fill;
  }
  .scene-evening .steam-layer {
    inset: 0;
    width: 100%;
    height: 100%;
  }
  :global(html[data-theme='afternoon']) .scene-morning,
  :global(html[data-theme='evening']) .scene-morning,
  :global(html[data-theme='night']) .scene-morning {
    display: none;
  }
  :global(html[data-theme='afternoon']) .scene-afternoon,
  :global(html[data-theme='evening']) .scene-evening,
  :global(html[data-theme='night']) .scene-night {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme])) .scene-morning,
    :global(html[data-theme='system']) .scene-morning {
      display: none;
    }
    :global(html:not([data-theme])) .scene-night,
    :global(html[data-theme='system']) .scene-night {
      display: block;
    }
  }

  .sun-dust {
    position: absolute;
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: #9eab79;
    opacity: 0.35;
    animation: dust-float 11s ease-in-out infinite alternate;
  }
  .dust-one {
    top: 25%;
    left: 22%;
  }
  .dust-two {
    top: 15%;
    right: 10%;
    animation-delay: -5s;
  }
  .steam-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .steam {
    opacity: 0;
    animation: steam-rise 6s ease-out infinite;
  }
  .steam-two {
    animation-delay: -2.3s;
    animation-duration: 7s;
  }
  .steam-three {
    animation-delay: -4.6s;
  }
  .moon-halo {
    position: absolute;
    width: 100%;
    aspect-ratio: 1;
    left: 0;
    top: 0;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      #f5eac50c,
      #f5eac505 35%,
      transparent 70%
    );
    animation: moon-glow 8s ease-in-out infinite alternate;
  }
  .scene-night {
    bottom: auto;
    left: 42%;
    right: 18%;
    height: auto;
    aspect-ratio: 1;
  }
  .scene-night :global(img) {
    opacity: 0.82;
    filter: drop-shadow(0 0 5px #eee7d40a);
    animation: moon-drift 12s ease-in-out infinite alternate;
  }

  @keyframes bird-breathe {
    0%,
    65%,
    100% {
      transform: scale(1);
    }
    75% {
      transform: translate(-3px, -3px) rotate(-1deg);
    }
  }
  @keyframes foliage-breeze {
    from {
      transform: rotate(-1deg);
    }
    to {
      transform: rotate(1.2deg);
    }
  }
  @keyframes dust-float {
    to {
      transform: translate(-6px, -14px);
      opacity: 0.1;
    }
  }
  @keyframes steam-rise {
    0% {
      transform: translate(0, 9px);
      opacity: 0;
    }
    25% {
      opacity: 0.35;
    }
    65% {
      opacity: 0.18;
    }
    100% {
      transform: translate(8px, -24px);
      opacity: 0;
    }
  }

  @keyframes arrive-from-edge {
    from {
      transform: translateX(120%) rotate(3deg);
      opacity: 0;
    }
    to {
      transform: translateX(0) rotate(0);
      opacity: 1;
    }
  }
  @keyframes serving-balance {
    from {
      transform: translateX(0) rotate(-0.6deg);
    }
    to {
      transform: translateX(-5px) rotate(0.6deg);
    }
  }
  @keyframes moon-drift {
    to {
      transform: translate(-3px, -5px);
    }
  }
  @keyframes moon-glow {
    from {
      opacity: 0.4;
    }
    to {
      opacity: 0.9;
    }
  }
  @keyframes branch-breeze {
    from {
      transform: rotate(-0.3deg);
    }
    to {
      transform: rotate(0.4deg);
    }
  }
  @keyframes doyel-flight {
    0%,
    12%,
    100% {
      transform: translate(0, 0) rotate(-3deg);
      opacity: 1;
    }
    25% {
      transform: translate(-30px, -35px) rotate(-8deg);
      opacity: 1;
    }
    38%,
    65% {
      transform: translate(-250px, -130px) scale(0.7);
      opacity: 0;
    }
    68% {
      transform: translate(100px, -90px) scale(0.75);
      opacity: 0;
    }
    86% {
      transform: translate(15px, -18px) rotate(4deg);
      opacity: 1;
    }
  }
  @keyframes wing-beat {
    from {
      transform: scaleY(0.82) rotate(-2deg);
    }
    to {
      transform: scaleY(1) rotate(2deg);
    }
  }
  @media (max-width: 1239px) {
    .ambient-scene {
      top: 112px;
      width: 160px;
      right: -8px;
    }
  }
  @media (max-width: 540px) {
    .ambient-scene {
      top: 112px;
      width: 130px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .steam {
      opacity: 0.2;
    }
  }
</style>
