---
import { Image } from 'astro:assets';
import morning from '../assets/ambient/morning.webp';
import afternoon from '../assets/ambient/afternoon.webp';
import evening from '../assets/ambient/evening.webp';
import night from '../assets/ambient/night.webp';
---

<div class="ambient-scene">
  <div class="scene scene-morning" aria-hidden="true">
    <Image
      class="bird-art"
      src={morning}
      alt=""
      widths={[240, 480, 720]}
      sizes="(max-width: 1239px) 100px, 220px"
      loading="lazy"
      decoding="async"
    />
    <span class="sun-dust dust-one"></span>
    <span class="sun-dust dust-two"></span>
  </div>
  <div class="scene scene-afternoon" aria-hidden="true">
    <Image
      class="plant-art"
      src={afternoon}
      alt=""
      widths={[240, 480, 720]}
      sizes="(max-width: 1239px) 100px, 220px"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="scene scene-evening" aria-hidden="true">
    <Image
      src={evening}
      alt=""
      widths={[240, 480, 720]}
      sizes="(max-width: 1239px) 100px, 220px"
      loading="lazy"
      decoding="async"
    />
    <svg
      class="steam-layer"
      viewBox="0 0 240 320"
      fill="none"
      aria-hidden="true"
    >
      <defs>
        <filter id="tea-softness">
          <feGaussianBlur stdDeviation="1.1" />
        </filter>
      </defs>
      <g
        filter="url(#tea-softness)"
        stroke="#a48d6c"
        stroke-width="2.5"
        stroke-linecap="round"
      >
        <path
          class="steam steam-one"
          d="M95 159c-24-26 24-40 1-65-9-11-6-21 2-33"
        />
        <path
          class="steam steam-two"
          d="M120 158c20-24-21-39-2-63 12-15 5-29 0-34"
        />
        <path class="steam steam-three" d="M146 163c-20-21 11-33 1-51" />
      </g>
    </svg>
  </div>
  <div class="scene scene-night" aria-hidden="true">
    <span class="lamp-halo"></span>
    <Image
      src={night}
      alt=""
      widths={[240, 480, 720]}
      sizes="(max-width: 1239px) 100px, 220px"
      loading="lazy"
      decoding="async"
    />
    <span class="lamp-glass-light"></span>
    <i class="firefly firefly-one"></i>
    <i class="firefly firefly-two"></i>
  </div>
</div>
<style>
  .ambient-scene {
    position: fixed;
    right: 32px;
    top: 150px;
    width: 220px;
    height: 294px;
    z-index: 2;
  }
  .scene {
    position: absolute;
    inset: 0;
    display: none;
  }
  .scene :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .scene-morning {
    display: block;
  }
  :global(html[data-theme='afternoon']) .scene-morning,
  :global(html[data-theme='evening']) .scene-morning,
  :global(html[data-theme='night']) .scene-morning {
    display: none;
  }
  :global(html[data-theme='afternoon']) .scene-afternoon,
  :global(html[data-theme='evening']) .scene-evening,
  :global(html[data-theme='night']) .scene-night {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme])) .scene-morning,
    :global(html[data-theme='system']) .scene-morning {
      display: none;
    }
    :global(html:not([data-theme])) .scene-night,
    :global(html[data-theme='system']) .scene-night {
      display: block;
    }
  }
  .scene-morning :global(.bird-art) {
    transform-origin: 50% 66%;
    animation: bird-breathe 7s ease-in-out infinite;
  }
  .scene-afternoon :global(.plant-art) {
    transform-origin: 52% 87%;
    animation: foliage-breeze 8s ease-in-out infinite alternate;
  }
  .sun-dust {
    position: absolute;
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: #9eab79;
    opacity: 0.35;
    animation: dust-float 11s ease-in-out infinite alternate;
  }
  .dust-one {
    top: 25%;
    left: 22%;
  }
  .dust-two {
    top: 15%;
    right: 10%;
    animation-delay: -5s;
  }
  .steam-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .steam {
    opacity: 0;
    animation: steam-rise 6s ease-out infinite;
  }
  .steam-two {
    animation-delay: -2.3s;
    animation-duration: 7s;
  }
  .steam-three {
    animation-delay: -4.6s;
  }
  .lamp-halo {
    position: absolute;
    width: 160px;
    height: 180px;
    left: 44%;
    top: 59%;
    transform: translate(-50%, -50%);
    background: radial-gradient(
      ellipse,
      #ffc65d25,
      #eab25b0a 48%,
      transparent 72%
    );
    animation: lamplight 7s ease-in-out infinite alternate;
  }
  .lamp-glass-light {
    position: absolute;
    left: 30%;
    top: 47%;
    width: 28%;
    height: 27%;
    border-radius: 45%;
    background: radial-gradient(ellipse, #ffdc8c33, transparent 70%);
    mix-blend-mode: screen;
    animation: lamplight 5s ease-in-out infinite alternate;
  }
  .firefly {
    position: absolute;
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: #f5df9c;
    box-shadow: 0 0 7px 2px #f2d17d33;
    animation: firefly-drift 10s ease-in-out infinite alternate;
  }
  .firefly-one {
    left: 12%;
    top: 65%;
  }
  .firefly-two {
    left: 64%;
    top: 81%;
    animation-delay: -5s;
  }
  @keyframes bird-breathe {
    0%,
    65%,
    100% {
      transform: scale(1);
    }
    75% {
      transform: scale(1.007) rotate(-0.2deg);
    }
  }
  @keyframes foliage-breeze {
    from {
      transform: skewX(-0.35deg) rotate(-0.3deg);
    }
    to {
      transform: skewX(0.45deg) rotate(0.35deg);
    }
  }
  @keyframes dust-float {
    to {
      transform: translate(-6px, -14px);
      opacity: 0.1;
    }
  }
  @keyframes steam-rise {
    0% {
      transform: translate(0, 9px);
      opacity: 0;
    }
    25% {
      opacity: 0.35;
    }
    65% {
      opacity: 0.18;
    }
    100% {
      transform: translate(8px, -24px);
      opacity: 0;
    }
  }
  @keyframes lamplight {
    from {
      opacity: 0.55;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes firefly-drift {
    from {
      transform: translate(0, 0);
      opacity: 0.1;
    }
    40% {
      opacity: 0.8;
    }
    to {
      transform: translate(-10px, -18px);
      opacity: 0.2;
    }
  }
  @media (max-width: 1370px) and (min-width: 1240px) {
    .ambient-scene {
      width: 170px;
      height: 227px;
      right: 16px;
    }
  }
  @media (max-width: 1239px) {
    .ambient-scene {
      right: 16px;
      top: 120px;
      width: 100px;
      height: 134px;
    }
    .lamp-halo {
      width: 90px;
      height: 100px;
    }
  }
  @media (max-width: 540px) {
    .ambient-scene {
      width: 64px;
      height: 86px;
      top: 112px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .steam {
      opacity: 0.2;
    }
  }
</style>
