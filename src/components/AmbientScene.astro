---
import { Image } from 'astro:assets';
import morning from '../assets/ambient/branch-clean.webp';
import bird from '../assets/ambient/doyel-poses.webp';
import evening from '../assets/ambient/rural-lantern.webp';
import moon from '../assets/ambient/moon.webp';
const sizes =
  '(max-width: 540px) 150px, (max-width: 1239px) 180px, (max-width: 1840px) calc((100vw - 800px) / 2 - 20px), 520px';
---

<div class="ambient-scene" data-motion-viewport data-ambient aria-hidden="true">
  <div class="scene scene-morning">
    <div class="wide-stage">
      <Image
        src={morning}
        alt=""
        widths={[240, 480, 720, 1200]}
        sizes={sizes}
        loading="eager"
        decoding="async"
      />
      <span class="bird-anchor">
        <span
          class="bird"
          data-bird
          data-sprite={bird.src}
          data-state="perched"
          style={`--bird-image: url('${bird.src}')`}
        >
          <span class="bird-pose"></span>
        </span>
      </span>
    </div>
  </div>
  <div class="scene scene-afternoon">
    <div class="countryside-stage">
      <svg class="afternoon-air" viewBox="0 0 720 480" fill="none">
        <g class="village-kite">
          <path
            d="M485 106Q476 250 405 440"
            stroke="#7a6849"
            stroke-width=".85"
            opacity=".65"
          />
          <g class="kite-canopy">
            <path d="m485 61 24 41-24 30-23-30Z" fill="#b58b46" />
            <path d="m485 61 24 41-24 30Z" fill="#8e603e" />
            <path d="M485 61v71m-23-30h47" stroke="#594e36" stroke-width=".8" />
            <path
              class="kite-ribbon"
              d="M485 132q-15 16 0 30t-3 31"
              stroke="#95744d"
              stroke-width="2"
            />
          </g>
        </g>
      </svg>
    </div>
  </div>
  <div class="scene scene-evening">
    <div class="lantern-stage">
      <div class="lantern-swing">
        <span class="lantern-cord"></span>
        <Image
          src={evening}
          alt=""
          widths={[240, 480, 720, 1200]}
          sizes={sizes}
          loading="lazy"
          decoding="async"
        />
        <span class="lantern-glow"></span>
        <span class="lantern-flame"></span>
      </div>
    </div>
    <span class="evening-firefly firefly-one"></span>
    <span class="evening-firefly firefly-two"></span>
  </div>
  <div class="scene scene-night">
    <span class="night-cloud cloud-one"></span>
    <span class="night-cloud cloud-two"></span>
    <Image
      src={moon}
      alt=""
      widths={[160, 320, 600]}
      sizes="(max-width: 1239px) 70px, 180px"
      loading="lazy"
      decoding="async"
    />
  </div>
</div>
<script>
  import { createBirdFlight } from '../lib/bird-flight';
  const cleanup: Array<() => void> = [];
  document.querySelectorAll<HTMLElement>('[data-ambient]').forEach((scene) => {
    const bird = createBirdFlight(
      scene.querySelector<HTMLElement>('[data-bird]')!,
    );
    const motion = scene.closest<HTMLElement>('[data-motion-scene]')!;
    const dark = matchMedia('(prefers-color-scheme: dark)');
    let mode = '';
    const theme = () => {
      const value = document.documentElement.dataset.theme;
      return !value || value === 'system'
        ? dark.matches
          ? 'night'
          : 'morning'
        : value;
    };
    const running = () =>
      !document.hidden &&
      document.documentElement.dataset.motion !== 'off' &&
      motion.dataset.paused === 'false';
    const stop = () => {
      bird.stop();
    };
    const sync = () => {
      bird.setVisible(theme() === 'morning');
      const next = (running() ? 'active:' : 'paused:') + theme();
      // Root and viewport observers may fire for the same change. Never restart a live flight twice.
      if (next === mode) return;
      mode = next;
      stop();
      if (!running()) return;
      if (theme() === 'morning') void bird.start();
    };
    const rootObserver = new MutationObserver(sync);
    rootObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme', 'data-motion'],
    });
    const motionObserver = new MutationObserver(sync);
    motionObserver.observe(motion, {
      attributes: true,
      attributeFilter: ['data-paused'],
    });
    dark.addEventListener('change', sync);
    document.addEventListener('visibilitychange', sync);
    const hide = () => {
      mode = '';
      stop();
    };
    window.addEventListener('pagehide', hide);
    window.addEventListener('pageshow', sync);
    cleanup.push(() => {
      rootObserver.disconnect();
      motionObserver.disconnect();
      dark.removeEventListener('change', sync);
      document.removeEventListener('visibilitychange', sync);
      window.removeEventListener('pagehide', hide);
      window.removeEventListener('pageshow', sync);
      bird.destroy();
    });
    sync();
  });
  if (import.meta.hot)
    import.meta.hot.dispose(() => cleanup.forEach((dispose) => dispose()));
</script>
<style>
  .ambient-scene {
    position: absolute;
    right: -2px;
    top: 150px;
    width: clamp(250px, calc((100vw - 800px) / 2 - 20px), 520px);
    aspect-ratio: 3 / 2;
    z-index: 2;
  }
  .scene {
    position: absolute;
    inset: 0;
    visibility: hidden;
    opacity: 0;
    transition:
      opacity 700ms ease,
      visibility 700ms;
  }
  .scene :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .wide-stage {
    position: absolute;
    inset: 0;
    aspect-ratio: 3 / 2;
  }
  .scene-morning {
    visibility: visible;
    opacity: 1;
  }
  .bird-anchor {
    position: absolute;
    /* Branch source: the grip is at (387, 508) in its 1200 x 800 image.
       Sprite source: the toes are at 38% x, 73% y in the resting frame. */
    left: 32.25%;
    top: 63.5%;
    width: 27%;
    aspect-ratio: 1;
    transform: translate(-38%, -73%);
  }
  .bird {
    position: absolute;
    inset: 0;
    display: block;
    transform-origin: 38% 73%;
  }
  .bird-pose {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--bird-image) 0 0 / 300% 100% no-repeat;
  }
  .bird[data-state='arriving'] .bird-pose,
  .bird[data-state='departing'] .bird-pose,
  .bird[data-state='taking-off'] .bird-pose {
    animation: wing-poses 180ms step-end infinite;
  }
  .bird[data-state='landing'] .bird-pose {
    animation: landing-poses 420ms step-end both;
  }
  .bird[data-state='away'] {
    opacity: 0;
  }
  .countryside-stage {
    position: absolute;
    inset: -3% -4% -3% 0;
  }
  .afternoon-air {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .village-kite {
    transform-origin: 405px 440px;
    animation: country-kite 6s ease-in-out infinite;
  }
  .kite-canopy {
    transform-origin: 485px 102px;
    animation: kite-bank 2.8s ease-in-out infinite alternate;
  }
  .kite-ribbon {
    transform-origin: 485px 132px;
    animation: kite-tail 0.9s ease-in-out infinite alternate;
  }
  :global(html:not([data-theme='afternoon'])) .afternoon-air * {
    animation-play-state: paused;
  }
  @keyframes country-kite {
    0%,
    100% {
      transform: rotate(-5deg);
    }
    40% {
      transform: rotate(6deg);
    }
    72% {
      transform: rotate(1deg);
    }
  }
  @keyframes kite-bank {
    from {
      transform: rotate(-11deg) scaleX(0.9);
    }
    to {
      transform: rotate(12deg) scaleX(1);
    }
  }
  @keyframes kite-tail {
    from {
      transform: skewX(-13deg);
    }
    to {
      transform: skewX(18deg);
    }
  }
  .lantern-stage {
    position: absolute;
    right: -4%;
    top: 0;
    width: 90%;
    aspect-ratio: 3 / 2;
  }
  .lantern-swing {
    position: absolute;
    inset: 0;
    transform-origin: 50% 2%;
    animation: lantern-sway 3.4s ease-in-out infinite alternate;
  }
  .lantern-cord {
    position: absolute;
    left: 50%;
    bottom: 97.5%;
    width: 1px;
    height: 80px;
    background: linear-gradient(transparent, #89795e 60%);
  }
  .lantern-flame {
    position: absolute;
    left: 48.7%;
    top: 57%;
    width: 2.8%;
    height: 12%;
    border-radius: 80% 25% 55% 45%;
    background: linear-gradient(#fff4bf, #ffd56e 55%, #e5a23b);
    filter: blur(0.5px);
    transform-origin: 50% 100%;
    mix-blend-mode: screen;
    animation: living-flame 1.1s ease-in-out infinite;
  }
  @keyframes living-flame {
    0%,
    100% {
      transform: rotate(-5deg) scale(0.8, 0.88);
      opacity: 0.65;
    }
    30% {
      transform: rotate(4deg) scale(1.08, 1.13);
      opacity: 0.95;
    }
    65% {
      transform: rotate(-2deg) scale(0.9, 0.96);
      opacity: 0.8;
    }
  }
  .lantern-glow {
    position: absolute;
    left: 44%;
    top: 49%;
    width: 12%;
    height: 21%;
    border-radius: 50%;
    background: radial-gradient(
      ellipse,
      #ffd082a6,
      #e9a74340 45%,
      transparent 72%
    );
    mix-blend-mode: screen;
    filter: blur(3px);
    animation: lantern-flicker 3.1s ease-in-out infinite;
  }
  .evening-firefly {
    position: absolute;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #d5b664;
    box-shadow: 0 0 8px #e1b85b55;
    animation: evening-glimmer 7s ease-in-out infinite;
  }
  .firefly-one {
    left: 30%;
    top: 43%;
  }
  .firefly-two {
    right: 9%;
    top: 65%;
    animation-delay: -3.8s;
    animation-duration: 9s;
  }
  :global(html:not([data-theme='evening'])) .lantern-swing,
  :global(html:not([data-theme='evening'])) .lantern-glow,
  :global(html:not([data-theme='evening'])) .lantern-flame,
  :global(html:not([data-theme='evening'])) .evening-firefly {
    animation-play-state: paused;
  }
  @keyframes lantern-sway {
    from {
      transform: rotate(-2.8deg);
    }
    to {
      transform: rotate(3.2deg);
    }
  }
  @keyframes lantern-flicker {
    0%,
    100% {
      opacity: 0.55;
      transform: scale(0.98, 1);
    }
    17% {
      opacity: 0.8;
      transform: scale(1.04, 0.95);
    }
    38% {
      opacity: 0.48;
      transform: scale(0.95, 1.05);
    }
    57% {
      opacity: 0.75;
      transform: scale(1.03, 1);
    }
    76% {
      opacity: 0.6;
      transform: scale(0.97, 0.98);
    }
  }
  @keyframes evening-glimmer {
    0%,
    100% {
      opacity: 0;
      transform: translate(0, 0);
    }
    35% {
      opacity: 0.8;
      transform: translate(-22px, -32px);
    }
    70% {
      opacity: 0.2;
      transform: translate(18px, -50px);
    }
  }
  .night-cloud {
    position: absolute;
    z-index: 2;
    left: -70%;
    top: 40%;
    width: 240%;
    height: 30%;
    border-radius: 50%;
    background:
      radial-gradient(ellipse at 35% 55%, #869ba98a, transparent 48%),
      radial-gradient(ellipse at 62% 50%, #a0acb357, transparent 55%);
    filter: blur(3px);
    animation: moon-cloud 11s linear infinite;
  }
  .cloud-two {
    top: 65%;
    width: 190%;
    height: 24%;
    animation-delay: -5.5s;
    animation-duration: 14s;
    opacity: 0.65;
  }
  @keyframes moon-cloud {
    0% {
      transform: translateX(-35%);
      opacity: 0;
    }
    20% {
      opacity: 0.8;
    }
    80% {
      opacity: 0.7;
    }
    100% {
      transform: translateX(55%);
      opacity: 0;
    }
  }
  :global(html:not([data-theme='night'])) .night-cloud {
    animation-play-state: paused;
  }
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme])) .night-cloud,
    :global(html[data-theme='system']) .night-cloud {
      animation-play-state: running;
    }
  }
  .scene-night {
    inset: 0 18% auto 42%;
    aspect-ratio: 1;
  }
  .scene-night :global(img) {
    opacity: 0.82;
    animation: moonlight 7s ease-in-out infinite alternate;
    filter: drop-shadow(0 0 12px #e6d9ac18);
  }
  .scene-night::before {
    content: '';
    position: absolute;
    left: -18%;
    top: 12%;
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: #ede5cf;
    box-shadow:
      31px 42px #ede5cf88,
      82px -12px #ede5cf66,
      122px 65px #ede5cf88;
    animation: star-glimmer 4.5s ease-in-out infinite alternate;
  }
  @keyframes moonlight {
    to {
      opacity: 0.97;
      filter: drop-shadow(0 0 20px #e6d9ac28);
    }
  }
  @keyframes star-glimmer {
    from {
      opacity: 0.25;
    }
    to {
      opacity: 0.9;
    }
  }
  :global(html[data-theme='afternoon']) .scene-morning,
  :global(html[data-theme='evening']) .scene-morning,
  :global(html[data-theme='night']) .scene-morning {
    opacity: 0;
    visibility: hidden;
  }
  :global(html[data-theme='afternoon']) .scene-afternoon,
  :global(html[data-theme='evening']) .scene-evening,
  :global(html[data-theme='night']) .scene-night {
    opacity: 1;
    visibility: visible;
  }

  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme])) .scene-morning,
    :global(html[data-theme='system']) .scene-morning {
      opacity: 0;
      visibility: hidden;
    }
    :global(html:not([data-theme])) .scene-night,
    :global(html[data-theme='system']) .scene-night {
      opacity: 1;
      visibility: visible;
    }
  }
  @keyframes wing-poses {
    0%,
    100% {
      background-position: 50% 0;
    }
    50% {
      background-position: 100% 0;
    }
  }
  @keyframes landing-poses {
    0% {
      background-position: 100% 0;
    }
    35% {
      background-position: 50% 0;
    }
    65%,
    100% {
      background-position: 0 0;
    }
  }
  @media (max-width: 1239px) {
    .ambient-scene {
      top: 112px;
      width: 180px;
      right: -8px;
    }
  }
  @media (max-width: 540px) {
    .ambient-scene {
      top: 112px;
      width: 150px;
    }
  }
  :global(html[data-motion='off']) .scene {
    transition: none;
  }
</style>
