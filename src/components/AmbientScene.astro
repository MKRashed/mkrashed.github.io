<script>
  const scene = document.querySelector<HTMLElement>('.ambient-scene');
  if (scene) {
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let visible = false;
    let manuallyPaused = false;
    const control = scene.querySelector<HTMLButtonElement>('.scene-control');
    const sync = () => {
      scene.dataset.paused = String(
        manuallyPaused || !visible || document.hidden || reducedMotion.matches,
      );
      if (control) control.hidden = reducedMotion.matches;
    };
    control?.addEventListener('click', () => {
      manuallyPaused = !manuallyPaused;
      control.setAttribute('aria-pressed', String(manuallyPaused));
      control.setAttribute(
        'aria-label',
        manuallyPaused
          ? 'Resume illustration animation'
          : 'Pause illustration animation',
      );
      control.title = manuallyPaused ? 'Resume animation' : 'Pause animation';
      sync();
    });
    const observer = new IntersectionObserver((entries) => {
      visible = entries[0].isIntersecting;
      sync();
    });
    observer.observe(scene);
    document.addEventListener('visibilitychange', sync);
    reducedMotion.addEventListener('change', sync);
    window.addEventListener('pagehide', () => {
      scene.dataset.paused = 'true';
    });
    window.addEventListener('pageshow', sync);
  }
</script>

<style>
  .ambient-scene {
    position: absolute;
    left: calc(100% + 48px);
    top: 60px;
    width: 220px;
    height: 312px;
    pointer-events: none;
    user-select: none;
  }
  .ambient-scene > svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .scene-control {
    position: absolute;
    right: 0;
    bottom: -25px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    color: var(--muted);
    border: 0;
    border-radius: 50%;
    background: transparent;
    pointer-events: auto;
  }
  .scene-control:hover {
    color: var(--fg);
    background: var(--surface);
  }
  .play-icon {
    display: none;
  }
  .scene-control[aria-pressed='true'] .play-icon {
    display: block;
  }
  .scene-control[aria-pressed='true'] .pause-icon {
    display: none;
  }
  .scene {
    display: none;
  }
  .scene-morning {
    display: inline;
  }
  :global(html[data-theme='afternoon']) .scene-morning,
  :global(html[data-theme='evening']) .scene-morning,
  :global(html[data-theme='night']) .scene-morning {
    display: none;
  }
  :global(html[data-theme='afternoon']) .scene-afternoon,
  :global(html[data-theme='evening']) .scene-evening,
  :global(html[data-theme='night']) .scene-night {
    display: inline;
  }
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme])) .scene-morning,
    :global(html[data-theme='system']) .scene-morning {
      display: none;
    }
    :global(html:not([data-theme])) .scene-night,
    :global(html[data-theme='system']) .scene-night {
      display: inline;
    }
  }
  .bird-hop {
    animation: bird-hop 11s ease-in-out infinite;
    transform-origin: 114px 230px;
  }
  .morning-motes {
    animation: mote-drift 12s ease-in-out infinite alternate;
  }
  .plant-sway {
    transform-origin: 150px 270px;
    animation: plant-sway 7s ease-in-out infinite alternate;
  }
  .butterfly-drift {
    animation: butterfly-drift 10s ease-in-out infinite;
  }
  .butterfly-wings {
    transform-origin: 68px 167px;
    animation: wing-flutter 1.8s ease-in-out infinite alternate;
  }
  .steam {
    opacity: 0;
    animation: steam-rise 5s ease-out infinite;
  }
  .steam-two {
    animation-delay: -1.8s;
    animation-duration: 5.8s;
  }
  .steam-three {
    animation-delay: -3.4s;
    animation-duration: 4.6s;
  }
  .lamp-halo {
    transform-origin: 121px 183px;
    animation: lamp-breathe 6s ease-in-out infinite alternate;
  }
  .lamp-flame {
    transform-origin: 122px 195px;
    animation: flame-flicker 3s ease-in-out infinite alternate;
  }
  .firefly {
    animation: firefly-drift 9s ease-in-out infinite alternate;
  }
  .firefly-two {
    animation-delay: -4s;
    animation-duration: 12s;
  }
  [data-paused='true'] svg * {
    animation-play-state: paused !important;
  }
  @keyframes bird-hop {
    0%,
    64%,
    78%,
    100% {
      transform: translateY(0) rotate(0);
    }
    67% {
      transform: translateY(1px) rotate(-2deg);
    }
    70% {
      transform: translateY(-7px) rotate(-3deg);
    }
    73% {
      transform: translateY(0) rotate(0);
    }
  }
  @keyframes mote-drift {
    to {
      transform: translate(-5px, -9px);
      opacity: 0.15;
    }
  }
  @keyframes plant-sway {
    from {
      transform: rotate(-1.5deg);
    }
    to {
      transform: rotate(2deg);
    }
  }
  @keyframes butterfly-drift {
    0%,
    100% {
      transform: translate(0, 0);
    }
    35% {
      transform: translate(-12px, -17px) rotate(-5deg);
    }
    70% {
      transform: translate(8px, -26px) rotate(4deg);
    }
  }
  @keyframes wing-flutter {
    to {
      transform: scaleX(0.65);
    }
  }
  @keyframes steam-rise {
    0% {
      transform: translate(0, 6px);
      opacity: 0;
    }
    25% {
      opacity: 0.4;
    }
    65% {
      opacity: 0.2;
    }
    100% {
      transform: translate(8px, -22px);
      opacity: 0;
    }
  }
  @keyframes lamp-breathe {
    from {
      opacity: 0.65;
      transform: scale(0.94);
    }
    to {
      opacity: 1;
      transform: scale(1.06);
    }
  }
  @keyframes flame-flicker {
    0%,
    100% {
      opacity: 0.85;
      transform: scaleX(0.96);
    }
    35% {
      opacity: 1;
      transform: scaleX(1.05) rotate(2deg);
    }
    70% {
      opacity: 0.8;
      transform: rotate(-2deg);
    }
  }
  @keyframes firefly-drift {
    0% {
      transform: translate(0, 0);
      opacity: 0.15;
    }
    40% {
      opacity: 0.8;
    }
    100% {
      transform: translate(-9px, -15px);
      opacity: 0.2;
    }
  }
  @media (max-width: 1370px) and (min-width: 1240px) {
    .ambient-scene {
      width: 170px;
      height: 241px;
      left: calc(100% + 30px);
      top: 80px;
    }
  }
  @media (max-width: 1239px) {
    .ambient-scene {
      position: relative;
      inset: auto;
      flex: 0 0 100px;
      width: 100px;
      height: 142px;
      margin-block: -30px -16px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ambient-scene svg * {
      animation: none !important;
    }
    .steam {
      opacity: 0.25;
    }
  }
</style>
