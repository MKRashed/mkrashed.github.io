---
import { profile } from '../data/profile';
import MotionScene from './MotionScene.astro';
import VillageScene from './VillageScene.astro';
---

<footer class="container reading-surface">
  <div>
    <a class="footer-name" href="/">
      {profile.name}
    </a>
    <p>
      {profile.title} · {profile.location}
    </p>
  </div>
  <div class="footer-right">
    <div class="link-row">
      <a href={profile.github}>GitHub ↗</a>
      <a href={profile.linkedin}>LinkedIn ↗</a>
      <a href="#top">Back to top ↑</a>
    </div>
    <p>© {new Date().getFullYear()} · Built with Astro</p>
  </div>
</footer>
<MotionScene className="footer-scenery">
  <VillageScene />
</MotionScene>
<style>
  footer {
    padding-block: 2.5rem;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    font-size: 0.75rem;
  }
  .footer-name {
    font-size: 0.9rem;
    text-decoration: none;
  }
  p {
    color: var(--muted);
    margin-top: 0.6rem;
  }
  .footer-right {
    text-align: right;
  }
  .link-row {
    gap: 1.25rem;
  }
  .link-row a {
    text-decoration: none;
  }
  @media (max-width: 700px) {
    footer {
      flex-direction: column;
    }
    .footer-right {
      text-align: left;
    }
  }
</style>
