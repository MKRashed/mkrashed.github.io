---
import { profile, experience } from '../data/profile';
---

<section id="home" class="hero" aria-labelledby="hero-heading">
  <p class="location">
    <span class="location-light" aria-hidden="true"></span>
    {profile.location}
    <span class="local-time" data-dhaka-clock></span>
  </p>
  <h1 id="hero-heading">
    {profile.name}
    <span aria-hidden="true">.</span>
  </h1>
  <p class="role">
    {profile.title} at {experience[0].company}.
  </p>
  <p id="about" class="introduction">
    {profile.introduction}
  </p>
  <div class="hero-footer">
    <div class="link-row">
      <a href="/about">
        More about me <span aria-hidden="true">→</span>
      </a>
      <a href={profile.github}>
        GitHub <span aria-hidden="true">↗</span>
      </a>
      <a href={profile.linkedin}>
        LinkedIn <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>
<script>
  const clock = document.querySelector<HTMLElement>('[data-dhaka-clock]');
  const format = new Intl.DateTimeFormat('en-GB', {
    timeZone: 'Asia/Dhaka',
    hour: '2-digit',
    minute: '2-digit',
    hour12: true,
  });
  const update = () => {
    if (clock) clock.textContent = format.format(new Date()).toUpperCase();
  };
  let timer: ReturnType<typeof setInterval>;
  const sync = () => {
    clearInterval(timer);
    if (!document.hidden) {
      update();
      timer = setInterval(update, 60000);
    }
  };
  document.addEventListener('visibilitychange', sync);
  window.addEventListener('pagehide', () => clearInterval(timer));
  window.addEventListener('pageshow', sync);
  sync();
</script>
<style>
  .hero {
    position: relative;
    padding-block: 5.5rem 4rem;
  }
  .location {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--muted);
    font-size: 0.8rem;
  }
  .location-light {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 9%, transparent);
    animation: location-breathe 4s ease-in-out infinite;
  }
  .local-time {
    font: 0.62rem var(--mono);
    letter-spacing: 0.02em;
    opacity: 0.7;
    padding-left: 0.65rem;
    border-left: 1px solid var(--border);
  }
  @keyframes location-breathe {
    50% {
      box-shadow: 0 0 0 7px color-mix(in srgb, var(--accent) 3%, transparent);
    }
  }
  h1 {
    margin-block: 1rem;
    font-size: clamp(2.5rem, 5.5vw, 3.75rem);
    line-height: 1.15;
    letter-spacing: -0.04em;
  }
  h1 span {
    color: var(--accent);
  }
  .role {
    font-size: 1.05rem;
  }
  .introduction {
    margin-top: 1rem;
    color: var(--muted);
    max-width: 59ch;
    font-size: 0.95rem;
    line-height: 1.85;
  }
  .link-row {
    gap: 1.5rem;
    font-size: 0.8rem;
  }
  .hero-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.75rem;
  }
  @media (max-width: 1239px) {
    .hero-footer .link-row {
      column-gap: 1.25rem;
      row-gap: 0.75rem;
    }
  }
  .link-row a {
    text-decoration: none;
  }
  .link-row span {
    display: inline-block;
    transition: transform 0.25s;
    margin-left: 0.25rem;
    color: var(--accent);
  }
  .link-row a:hover span {
    transform: translate(3px, -2px);
  }
  @media (max-width: 700px) {
    .hero {
      padding-block: 3.5rem 3rem;
    }
  }
</style>
