---
interface Props {
  className: string;
}
const { className } = Astro.props;
---

<div
  class:list={['motion-scene', className]}
  data-motion-scene
  data-paused="true"
>
  <slot />
</div>
<script>
  document
    .querySelectorAll<HTMLElement>('[data-motion-scene]')
    .forEach((scene) => {
      let visible = false;
      const sync = () => {
        scene.dataset.paused = String(
          !visible ||
            document.hidden ||
            document.documentElement.dataset.motion === 'off',
        );
      };
      const observer = new IntersectionObserver((entries) => {
        visible = entries[0].isIntersecting;
        sync();
      });
      observer.observe(scene.querySelector('[data-motion-viewport]') ?? scene);
      document.addEventListener('visibilitychange', sync);
      new MutationObserver(sync).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-motion'],
      });
      window.addEventListener('pagehide', () => {
        scene.dataset.paused = 'true';
      });
      window.addEventListener('pageshow', sync);
    });
</script>
<style>
  .motion-scene {
    pointer-events: none;
    user-select: none;
  }
  .motion-scene[data-paused='true'] :global(*) {
    animation-play-state: paused !important;
  }
  :global(html[data-motion='off']) .motion-scene :global(*) {
    animation-play-state: paused !important;
  }
</style>
