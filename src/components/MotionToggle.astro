<button
  class="motion-toggle"
  type="button"
  data-motion-toggle
  role="switch"
  aria-label="Scene motion"
  title="Pause animations"
  aria-checked="true"
  hidden
>
  <svg
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    aria-hidden="true"
  >
    <path d="M3 8h12a3 3 0 1 0-3-3M3 12h16a3 3 0 1 1-3 3M3 16h5" />
  </svg>
  <span>Scene motion</span>
  <span class="motion-state" data-motion-state>
    On
  </span>
</button>
<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>(
    '[data-motion-toggle]',
  );
  const system = matchMedia('(prefers-reduced-motion: reduce)');
  let preference: string | null = null;
  try {
    preference = localStorage.getItem('site-motion');
  } catch {}
  const sync = () => {
    const enabled =
      preference === 'on' || (preference !== 'off' && !system.matches);
    root.dataset.motion = enabled ? 'on' : 'off';
    if (!button) return;
    button.hidden = false;
    button.setAttribute('aria-checked', String(enabled));
    const state = button.querySelector('[data-motion-state]');
    if (state) state.textContent = enabled ? 'On' : 'Off';
    button.title = enabled ? 'Pause animations' : 'Play animations';
  };
  button?.addEventListener('click', () => {
    preference = root.dataset.motion === 'on' ? 'off' : 'on';
    try {
      localStorage.setItem('site-motion', preference);
    } catch {}
    sync();
  });
  system.addEventListener('change', sync);
  window.addEventListener('storage', (event) => {
    if (event.key !== 'site-motion' && event.key !== null) return;
    preference = event.newValue;
    sync();
  });
  sync();
</script>
<style>
  .motion-toggle {
    display: grid;
    grid-template-columns: 18px 1fr auto;
    align-items: center;
    gap: 0.75rem;
    clear: both;
    width: 100%;
    min-height: 48px;
    margin-top: 0.5rem;
    padding: 0.65rem;
    border: 0;
    border-top: 1px solid var(--border);
    border-radius: 0;
    background: transparent;
    color: var(--muted);
    text-align: left;
    font-size: 0.7rem;
    transition:
      color 0.2s,
      border-color 0.2s,
      background-color 0.2s;
  }
  .motion-toggle:hover {
    color: var(--accent);
    background: var(--surface);
  }
  .motion-state {
    font: 0.62rem var(--mono);
    color: var(--accent);
  }
</style>
