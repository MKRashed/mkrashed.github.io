---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}
const { eyebrow, title, description } = Astro.props;
---

<div class="section-title">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2>{title}</h2>
  {description && <p class="description">{description}</p>}
</div>
<style>
  .eyebrow + h2 {
    margin-top: 0.8rem;
  }
  .description {
    color: var(--muted);
    font-size: 0.9rem;
    margin-top: 1rem;
  }
</style>
