---
import { technologies } from '../data/profile';
---

<dl class="skills">
  {technologies.map((group) => (
    <div>
      <dt>{group.label}</dt>
      <dd>{group.items.join(' · ')}</dd>
    </div>
  ))}
</dl>
<style>
  .skills {
    margin: 0;
  }
  .skills > div {
    display: grid;
    grid-template-columns: 105px 1fr;
    gap: 1.25rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--border);
  }
  .skills > div:first-child {
    padding-top: 0;
  }
  dt {
    font-size: 0.8rem;
    color: var(--muted);
  }
  dd {
    margin: 0;
    font-size: 0.9rem;
  }
  @media (max-width: 420px) {
    .skills > div {
      grid-template-columns: 80px 1fr;
      gap: 0.75rem;
    }
  }
</style>
