---
import MotionToggle from './MotionToggle.astro';
const options = [
  {
    value: 'system',
    label: 'System',
    hint: 'Device setting',
    path: 'M3 4h18v12H3zM8 21h8m-4-5v5',
  },
  {
    value: 'morning',
    label: 'Morning',
    hint: 'Doyel & daylight',
    path: 'M3 17h18M5 21h14M7 13a5 5 0 0 1 10 0M12 2v3M3 7l2 2m14 0 2-2',
  },
  {
    value: 'afternoon',
    label: 'Afternoon',
    hint: 'Kites over the village',
    path: 'M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0',
  },
  {
    value: 'evening',
    label: 'Evening',
    hint: 'Lantern light',
    path: 'M3 17h18M5 21h14M7 13a5 5 0 0 1 10 0M12 3v5m-2-2 2 2 2-2M3 7l2 2m14 0 2-2',
  },
  {
    value: 'night',
    label: 'Night',
    hint: 'Moonlit countryside',
    path: 'M20.9 13a9 9 0 0 1-9.9-9.9A9 9 0 1 0 20.9 13Z',
  },
];
---

<details id="theme-picker" class="theme-picker" hidden>
  <summary aria-label="Color theme: System">
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <path id="theme-icon" d={options[0].path} />
    </svg>
    <span id="theme-label">System</span>
    <svg
      class="chevron"
      width="12"
      height="12"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <path d="m7 10 5 5 5-5" />
    </svg>
  </summary>
  <fieldset class="theme-options">
    <legend>Appearance</legend>
    {options.map((option) => (
      <label class="theme-option">
        <input
          type="radio"
          name="color-theme"
          value={option.value}
          checked={option.value === 'system'}
        />
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path d={option.path} />
        </svg>
        <span>
          <span class="option-name">{option.label}</span>
          <small>{option.hint}</small>
        </span>
        <span class="check" aria-hidden="true">
          ✓
        </span>
      </label>
    ))}
    <MotionToggle />
  </fieldset>
</details>
<script>
  const picker = document.querySelector<HTMLDetailsElement>('#theme-picker');
  const summary = picker?.querySelector('summary');
  const system = window.matchMedia('(prefers-color-scheme: dark)');
  const radios = picker?.querySelectorAll<HTMLInputElement>(
    'input[name="color-theme"]',
  );
  const names: Record<string, string> = {
    system: 'System',
    morning: 'Morning',
    afternoon: 'Afternoon',
    evening: 'Evening',
    night: 'Night',
  };

  function syncTheme() {
    const theme = document.documentElement.dataset.theme || 'system';
    const choice = [...(radios ?? [])].find((radio) => radio.value === theme);
    if (choice) {
      choice.checked = true;
      const path = choice
        .closest('label')
        ?.querySelector('path')
        ?.getAttribute('d');
      if (path) document.querySelector('#theme-icon')?.setAttribute('d', path);
    }
    const text = document.querySelector('#theme-label');
    if (text) text.textContent = names[theme] || 'System';
    summary?.setAttribute(
      'aria-label',
      `Color theme: ${names[theme] || 'System'}`,
    );
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute(
        'content',
        getComputedStyle(document.documentElement)
          .getPropertyValue('--bg')
          .trim(),
      );
  }

  if (picker) {
    picker.hidden = false;
    syncTheme();
    picker.addEventListener('change', (event) => {
      const input = event.target;
      if (!(input instanceof HTMLInputElement) || !names[input.value]) return;
      document.documentElement.dataset.theme = input.value;
      try {
        localStorage.setItem('theme', input.value);
      } catch {}
      syncTheme();
      picker.open = false;
    });
    // Keep the native radio group's arrow-key navigation available while open.
    picker.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        picker.open = false;
        summary?.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !picker.contains(event.target))
        picker.open = false;
    });
    document.addEventListener('focusin', (event) => {
      if (event.target instanceof Node && !picker.contains(event.target))
        picker.open = false;
    });
    system.addEventListener('change', syncTheme);
    window.addEventListener('storage', (event) => {
      if (event.key !== 'theme') return;
      const theme =
        event.newValue === 'light'
          ? 'morning'
          : event.newValue === 'dark'
            ? 'night'
            : event.newValue;
      document.documentElement.dataset.theme =
        theme && names[theme] ? theme : 'system';
      syncTheme();
    });
  }
</script>
<style>
  .theme-picker {
    position: relative;
    flex: 0 0 auto;
    z-index: 30;
    font-size: 0.75rem;
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    min-height: 44px;
    padding: 0.55rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 30px;
    list-style: none;
    cursor: pointer;
    color: var(--fg);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    border-color: var(--accent);
  }
  summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  .chevron {
    color: var(--muted);
  }
  [open] .chevron {
    transform: rotate(180deg);
  }
  .theme-options {
    position: absolute;
    top: calc(100% + 0.65rem);
    right: 0;
    width: 210px;
    margin: 0;
    padding: 0.5rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--bg);
    box-shadow: 0 12px 35px #00000014;
  }
  legend {
    float: left;
    width: 100%;
    padding: 0.4rem 0.65rem 0.6rem;
    color: var(--muted);
    font-size: 0.65rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .theme-option {
    display: grid;
    grid-template-columns: 18px 1fr 14px;
    gap: 0.75rem;
    align-items: center;
    clear: both;
    min-height: 55px;
    padding: 0.55rem 0.65rem;
    border-radius: 6px;
    cursor: pointer;
  }
  .theme-option:hover,
  .theme-option:has(input:checked) {
    background: var(--surface);
  }
  .theme-option:has(input:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .theme-option > svg {
    color: var(--muted);
  }
  .option-name,
  small {
    display: block;
  }
  small {
    margin-top: 0.1rem;
    color: var(--muted);
    font-size: 0.68rem;
  }
  .check {
    visibility: hidden;
    color: var(--accent);
  }
  .theme-option:has(input:checked) .check {
    visibility: visible;
  }
</style>
