---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';
interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  noindex?: boolean;
}
const {
  title = `${profile.name} — ${profile.title}`,
  description = profile.introduction,
  type = 'website',
  publishedTime,
  noindex = false,
} = Astro.props;
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
const socialImage = Astro.site
  ? new URL('/social-card.png', Astro.site)
  : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafaf7" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content="en_US" />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:width" content="1200" />}
    {socialImage && <meta property="og:image:height" content="630" />}
    {socialImage && (
      <meta
        property="og:image:alt"
        content={`${profile.name}, ${profile.title}`}
      />
    )}
    {publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      try {
        const stored = localStorage.getItem('theme');
        const preference =
          stored === 'light' ? 'morning' : stored === 'dark' ? 'night' : stored;
        if (
          preference &&
          ['system', 'morning', 'afternoon', 'evening', 'night'].includes(
            preference,
          )
        )
          document.documentElement.dataset.theme = preference;
      } catch {}
      const dark =
        document.documentElement.dataset.theme === 'night' ||
        ((!document.documentElement.dataset.theme ||
          document.documentElement.dataset.theme === 'system') &&
          matchMedia('(prefers-color-scheme: dark)').matches);
      document
        .querySelector('meta[name="theme-color"]')
        ?.setAttribute(
          'content',
          dark
            ? '#202e38'
            : { afternoon: '#faf7ee', evening: '#eee4d1' }[
                document.documentElement.dataset.theme
              ] || '#fafaf7',
        );
    </script>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main" class="container" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
