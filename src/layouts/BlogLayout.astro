---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { profile } from '../data/profile';
import { formatDate, readingTime } from '../lib/blog';
interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
---

<BaseLayout
  title={`${post.data.title} — ${profile.name}`}
  description={post.data.description}
  type="article"
  publishedTime={post.data.pubDate.toISOString()}
>
  <article class="article">
    <header class="article-heading">
      <a class="text-link" href="/blog">
        ← All articles
      </a>
      <p class="eyebrow meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate)}
        </time>{' '}
        · {readingTime(post)}
      </p>
      <h1>{post.data.title}</h1>
      <p class="muted description">{post.data.description}</p>
      <p class="byline">By {profile.name}</p>
      <ul class="tags" aria-label="Tags">
        {post.data.tags.map((tag) => (
          <li>
            <a href={`/blog/tags/${encodeURIComponent(tag)}`}>{tag}</a>
          </li>
        ))}
      </ul>
    </header>
    <div class="prose">
      <slot />
    </div>
    <div class="article-footer">
      <a href="/blog">← Back to all articles</a>
    </div>
  </article>
</BaseLayout>
<style>
  .article {
    max-width: 70ch;
    margin-inline: auto;
    padding-block: 3rem;
  }
  .meta {
    margin-block: 2.5rem 1rem;
  }
  h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    overflow-wrap: anywhere;
  }
  .description {
    margin-top: 1.5rem;
    font-size: 1.1rem;
  }
  .byline {
    font-size: 0.8rem;
    margin-top: 1rem;
  }
  .article-heading {
    padding-bottom: 2.5rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
  }
  .article-footer {
    margin-top: 3rem;
    padding-block: 2rem;
    border-top: 1px solid var(--border);
    font-size: 0.875rem;
  }
</style>
