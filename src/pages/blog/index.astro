---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { profile } from '../../data/profile';
import { getPublishedPosts } from '../../lib/blog';
const posts = await getPublishedPosts();
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<BaseLayout
  title={`Blog — ${profile.name}`}
  description="Articles and notes on web development and practical software engineering by Rashedul Islam."
>
  <header class="page-heading">
    <p class="eyebrow">Notes / Ideas / Engineering</p>
    <h1>
      A space
      <br />
      <em>for the thinking.</em>
    </h1>
    <p>Articles on web development and the problems behind the code.</p>
  </header>
  <section class="articles" aria-label="Articles">
    {posts.length ? (
      <>
        {tags.length > 0 && (
          <nav aria-label="Browse articles by tag">
            <ul class="tags">
              {tags.map((tag) => (
                <li>
                  <a href={`/blog/tags/${encodeURIComponent(tag)}`}>{tag}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}
        {posts.map((post) => (
          <BlogCard post={post} headingLevel={2} />
        ))}
      </>
    ) : (
      <div class="empty-state">
        <p class="eyebrow">Nothing published yet</p>
        <h2>The page before the first post.</h2>
        <p>
          There are no published articles here yet. In the meantime, you can
          explore my background or connect with me on GitHub.
        </p>
        <div class="link-row">
          <a class="text-link" href="/about">
            About me →
          </a>
          <a class="text-link" href={profile.github}>
            GitHub ↗
          </a>
        </div>
      </div>
    )}
  </section>
</BaseLayout>
<style>
  em {
    color: var(--accent);
  }
  .articles {
    margin-bottom: 6rem;
  }
  .empty-state {
    padding: clamp(1.5rem, 5vw, 3rem);
  }
  .empty-state h2 {
    margin-block: 1rem;
    font-size: 2rem;
  }
  nav {
    margin-bottom: 2rem;
  }
</style>
